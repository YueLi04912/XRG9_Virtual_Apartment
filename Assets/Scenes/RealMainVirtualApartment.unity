    - target: {fileID: 8649429214862642061, guid: 2ac6671e1755b85489c7087be4fe074c,
        type: 3}
      propertyPath: m_text
      value: "<b>Your Task:</b>\n\n<b>Scenario: Prepare a Quick Snack</b>\n\n1. Prep
        Food (Wash & Place):\nPick up the fruit from the sink and put it on the cutting
        board.\n(Check counter height & prep workspace)\n\n2. Reach Upper Cabinet:\nReach
        up to touch the overhead cabinet handle.\n(Check shelf height & reach comfort)\n\n3.
        Check Entrance & Fridge:\nStep to the doorway and check the fridge swing
        clearance.\n\n[Feedback Rule]\n\u2022 Gray     = Fixed Layouts, others: modifiable\n\u2022
        Use annotaion system to leave a comment\n\u2022 Tell the facilitator when
        reviewing is finished.\n"
      objectReference: {fileID: 0}
